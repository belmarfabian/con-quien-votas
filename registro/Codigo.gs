var PARTIDOS = [["PC", "Partido Comunista de Chile"], ["FA", "Frente Amplio"], ["PS", "Partido Socialista de Chile"], ["PPD", "Partido por la Democracia"], ["FRVS", "Federación Regionalista Verde Social"], ["PR", "Partido Radical de Chile"], ["PL", "Partido Liberal de Chile"], ["DC", "Partido Demócrata Cristiano"], ["PDG", "Partido de la Gente"], ["PCC", "Partido Cristiano de Chile"], ["EVOP", "Evolución Política"], ["RN", "Renovación Nacional"], ["UDI", "Unión Demócrata Independiente"], ["PNL", "Partido Nacional Libertario"], ["REP", "Partido Republicano"]];
var LEEME = [["tema", "explicación"], ["qué es", "Respuestas anónimas del juego ¿Con quién votas? (belmarfabian.github.io/con-quien-votas). No se guarda nombre, correo, IP ni ningún dato que identifique a la persona."], ["filas", "Cada fila es una vista de resultados. Si alguien responde diez más, aparece otra fila con la misma partida y la ronda siguiente. Para analizar, usa la última fila de cada partida."], ["fecha", "Hora de llegada, según la zona horaria de esta planilla."], ["partida", "Código al azar creado al empezar cada partida. Sirve para unir rondas; no identifica a la persona."], ["banco", "actual = proyectos votados desde el 11 de marzo de 2026; anterior = 100 proyectos del período 2022–2026. Vacío en filas de la versión anterior del juego."], ["ronda", "1 = primeras diez preguntas; 2 = veinte; y así sucesivamente. En filas de la versión cqv1, cada ronda tenía cinco preguntas."], ["ver_tablero", "1 si la persona eligió ver cómo votó cada partido después de cada proyecto; 0 si no."], ["votados", "Cantidad de votos a favor o en contra. «Paso» no cuenta."], ["top", "Partido con más afinidad (sigla). Si hay empate, las siglas van unidas con +."], ["orden", "Votaciones en el orden en que aparecieron."], ["v_<votación>", "Voto de la persona: 1 = a favor, -1 = en contra, 0 = paso, vacío = no le tocó. El detalle de cada votación está en la hoja proyectos."], ["af_<sigla>", "Afinidad con el partido, de 0 a 100. Vacío si hay menos de tres proyectos comparables. Los nombres están en la hoja partidos."], ["version", "Versión del registro: cqv2 desde octubre de 2026 (rondas de diez y dos grupos de proyectos)."], ["columnas nuevas", "Si el juego suma proyectos, el script agrega sus columnas v_ al final de la cabecera, sin mover las existentes."], ["pruebas", "Filas enviadas desde la página con ?prueba=1 al final de la dirección. No son respuestas reales."]];
var CABECERA = ['fecha', 'partida', 'banco', 'ronda', 'ver_tablero', 'votados', 'top', 'orden']
  .concat(PROYECTOS.map(function (p) { return 'v_' + p.id; }))
  .concat(PARTIDOS.map(function (p) { return 'af_' + p[0]; }))
  .concat(['version']);

function doPost(e) {
  var texto = (e && e.postData && e.postData.contents) || '';
  if (texto.length > 8000) return salida_('muy largo');
  var d;
  try { d = JSON.parse(texto); } catch (err) { return salida_('no es json'); }
  if (!d || typeof d !== 'object') return salida_('no es json');
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var hoja = hoja_(d.prueba ? 'pruebas' : 'respuestas');
    var fila = cabecera_(hoja).map(function (c) { return valor_(c, d); });
    hoja.appendRow(fila);
    return salida_('ok');
  } finally {
    lock.releaseLock();
  }
}

function doGet() {
  return salida_('Registro de ¿Con quién votas? activo.');
}

/* valor de una columna a partir de lo que envía el juego */
function valor_(c, d) {
  var votos = d.votos || {}, af = d.afinidad || {};
  if (c === 'fecha') return new Date();
  if (c.indexOf('v_') === 0) { var v = votos[c.slice(2)]; return v === 1 || v === -1 || v === 0 ? v : ''; }
  if (c.indexOf('af_') === 0) { var a = af[c.slice(3)]; return typeof a === 'number' && a >= 0 && a <= 100 ? Math.round(a) : ''; }
  if (c === 'orden') return limpio_((d.orden || []).join(' '), 1200);
  if (c === 'banco') return d.banco === 'actual' || d.banco === 'anterior' ? d.banco : '';
  var x = d[c];
  if (typeof x === 'number' && isFinite(x)) return x;
  return limpio_(x, 60);
}

/* lee la cabecera de la hoja y agrega al final las columnas que falten, sin mover las existentes */
function cabecera_(hoja) {
  var n = hoja.getLastColumn();
  var actual = n ? hoja.getRange(1, 1, 1, n).getValues()[0].map(String) : [];
  var faltan = CABECERA.filter(function (c) { return actual.indexOf(c) < 0; });
  if (faltan.length) {
    var total = actual.length + faltan.length;
    if (hoja.getMaxColumns() < total) hoja.insertColumnsAfter(hoja.getMaxColumns(), total - hoja.getMaxColumns());
    hoja.getRange(1, actual.length + 1, 1, faltan.length).setNumberFormat('@').setValues([faltan]).setFontWeight('bold');
    actual = actual.concat(faltan);
  }
  return actual;
}

/* solo letras, números y pocos signos; nunca empieza con un signo que la planilla lea como fórmula */
function limpio_(x, max) {
  return String(x == null ? '' : x).replace(/[^A-Za-z0-9+_. -]/g, '').replace(/^[=+@-]+/, '').slice(0, max);
}

function salida_(t) {
  return ContentService.createTextOutput(t);
}

function hoja_(nombre) {
  var libro = SpreadsheetApp.getActiveSpreadsheet();
  var h = libro.getSheetByName(nombre);
  if (!h) { preparar(); h = libro.getSheetByName(nombre); }
  return h;
}

/* arma o actualiza las hojas. respuestas y pruebas: si no tienen filas, reescribe la cabecera; si tienen, solo agrega columnas.
   proyectos, partidos y léeme: se reescriben completas */
function preparar() {
  var libro = SpreadsheetApp.getActiveSpreadsheet();
  function datos(nombre) {
    var h = libro.getSheetByName(nombre) || libro.insertSheet(nombre);
    if (h.getLastRow() <= 1) {
      h.clear();
      if (h.getMaxColumns() < CABECERA.length) h.insertColumnsAfter(h.getMaxColumns(), CABECERA.length - h.getMaxColumns());
      h.getRange(1, 1, 1, CABECERA.length).setNumberFormat('@').setValues([CABECERA]).setFontWeight('bold');
      h.setFrozenRows(1);
      [150, 140, 80, 60, 90, 70, 90, 300].forEach(function (w, i) { h.setColumnWidth(i + 1, w); });
      if (h.getMaxRows() > 1) {
        h.getRange(2, 1, h.getMaxRows() - 1, 1).setNumberFormat('yyyy-mm-dd hh:mm:ss');
        h.getRange(2, 2, h.getMaxRows() - 1, CABECERA.length - 1).setNumberFormat('General');
      }
    } else {
      cabecera_(h);
    }
  }
  function catalogo(nombre, filas, anchos) {
    var h = libro.getSheetByName(nombre) || libro.insertSheet(nombre);
    h.clear();
    h.getRange(1, 1, filas.length, filas[0].length).setNumberFormat('@').setValues(filas);
    h.getRange(1, 1, 1, filas[0].length).setFontWeight('bold');
    h.setFrozenRows(1);
    (anchos || []).forEach(function (w, i) { if (w) h.setColumnWidth(i + 1, w); });
  }
  datos('respuestas');
  datos('pruebas');
  catalogo('proyectos', [['columna', 'votacion_id', 'banco', 'boletin', 'fecha_sala', 'tema', 'pregunta', 'resultado_sala']]
    .concat(PROYECTOS.map(function (p) { return ['v_' + p.id, p.id, p.banco, p.bol, p.f, p.tema, p.q, p.sala]; })), [80, 90, 80, 90, 90, 130, 620, 170]);
  catalogo('partidos', [['columna', 'sigla', 'partido', 'orden_eje']]
    .concat(PARTIDOS.map(function (p, i) { return ['af_' + p[0], p[0], p[1], String(i + 1)]; })), [80, 60, 280, 80]);
  catalogo('léeme', LEEME, [110, 900]);
  var vacia = libro.getSheetByName('Hoja 1') || libro.getSheetByName('Sheet1');
  if (vacia && vacia.getLastRow() === 0 && libro.getSheets().length > 1) libro.deleteSheet(vacia);
}
